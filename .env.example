# Database
POSTGRES_URL=postgresql://anneal:anneal@localhost:5432/anneal
POSTGRES_PASSWORD=anneal
# POSTGRES_PORT=5432

# ClickHouse
CLICKHOUSE_URL=http://localhost:8123
CLICKHOUSE_DB=anneal
# CLICKHOUSE_HTTP_PORT=8123
# CLICKHOUSE_NATIVE_PORT=9000

# API
ANNEAL_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
ANNEAL_ENDPOINT=http://localhost:8000
ANNEAL_ORG_ID=org_demo
ANNEAL_API_KEY=dev_optional
# For multiple organizations, use a JSON object instead of ANNEAL_API_KEY:
# ANNEAL_API_KEYS_JSON={"org_acme":"replace-with-a-random-api-key"}

# Dashboard auth
AUTH_SECRET=replace-with-a-long-random-string
ANNEAL_DEMO_MODE=true
ANNEAL_DATA_SOURCE=api
ANNEAL_ORG_NAME=Prompt 7 Demo
# Required when ANNEAL_DEMO_MODE=false:
# ANNEAL_DASHBOARD_EMAIL=lead@example.com
# ANNEAL_DASHBOARD_PASSWORD=replace-with-a-strong-password

# Optional marketing waitlist delivery
# ANNEAL_WAITLIST_WEBHOOK_URL=https://example.com/waitlist
# ANNEAL_WAITLIST_WEBHOOK_TOKEN=

# Agent API keys — never pass through an LLM context
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Weekly worker (production mode)
ANNEAL_MODE=demo
# ANNEAL_TASK=optimize
# ANNEAL_CONFIG_PATH=anneal.yml
# ANNEAL_AGENT_RUNNER_URL=https://agent.example.com/internal/anneal-eval
# ANNEAL_AGENT_RUNNER_API_KEY=
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# Optional dashboard GitHub App link:
# ANNEAL_GITHUB_APP_INSTALL_URL=https://github.com/apps/your-app/installations/new

# Optional SMTP delivery for weekly digests and regression alarms
# ANNEAL_SMTP_HOST=
# ANNEAL_SMTP_PORT=587
# ANNEAL_SMTP_USER=
# ANNEAL_SMTP_PASSWORD=
# ANNEAL_DIGEST_FROM=anneal@example.com
# ANNEAL_DIGEST_TO=team@example.com
# ANNEAL_ALERT_FROM=anneal@example.com
# ANNEAL_ALERT_TO=team@example.com
